# Copy to .env in the project root; chmod 600 .env; replace placeholders locally.
# Trusted shell syntax: quote values; never paste secrets in ordinary agent chat.
FEISHU_BIN='lark-cli'
# full: shared filesystem (legacy); inbound: external ingress + HTTP callbacks.
# cloud-worker starts no listeners; invoke worker_progress.py per routine run.
RELAY_ROLE='full'
PYTHON_BIN='python3'
LARK_CLI='lark-cli'
# A dedicated profile preserves other local apps. Leave empty for active profile.
FEISHU_PROFILE=''
# Required with inbound: an HTTPS reverse proxy to loopback BRIDGE_PORT.
BRIDGE_PUBLIC_URL='https://bridge.example'
BRIDGE_PORT='8765'
FEISHU_BOT_NAME='Grok Bot'
# Required for group @mentions; bot open_id, not app_id.
FEISHU_BOT_OPEN_ID='ou_replace_with_bot_open_id'
# Both lists are required. Empty means deny; no wildcard is supported.
FEISHU_ALLOWED_USERS='ou_replace_with_your_open_id'
FEISHU_ALLOWED_CHATS='oc_replace_with_chat_id'
# Copy from the Grok Bot webhook routine UI using secure secret inputs.
FEISHU_RELAY_WEBHOOK_URL='https://replace-with-your-routine-endpoint.example/webhook'
FEISHU_RELAY_WEBHOOK_KEY='replace-with-your-routine-key'
FEISHU_RELAY_ACK_EMOJI='OnIt'
FEISHU_PROGRESS_HEARTBEAT_SEC='12'
FEISHU_PROGRESS_PATCH_MIN_SEC='1.0'
FEISHU_PROGRESS_QUEUED_TIMEOUT_SEC='600'
FEISHU_PROGRESS_RUNNING_STALE_SEC='1800'
FEISHU_QUEUE_SCAN_SEC='5'
FEISHU_BUS_SKEW_POLL_SEC='5'
FEISHU_BUS_SKEW_SEC='30'
FEISHU_BUS_HEALTH_SEC='120'
FEISHU_BUS_REFRESH_COOLDOWN_SEC='180'
# Zero receive count alone does not prove a broken connection.
FEISHU_BUS_ZOMBIE_UPTIME_SEC='0'
FEISHU_BUS_MAX_UPTIME_SEC='0'
